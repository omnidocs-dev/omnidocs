{
	auto_https disable_redirects
	default_sni {$OMNIDOCS_SITE_HOST}
	skip_install_trust
}

{$OMNIDOCS_SITE_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	@blockedAdmin {
		path /admin /admin/*
		not remote_ip {$OMNIDOCS_ADMIN_NETWORKS:127.0.0.1/32 ::1/128}
	}
	@api path /api /api/* /admin/api /admin/api/*
	route {
		respond @blockedAdmin 404
		handle @api {
			reverse_proxy backend:4174
		}
		handle {
			header {
				Referrer-Policy no-referrer
				X-Content-Type-Options nosniff
				X-Frame-Options DENY
				Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
				-Server
			}
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}

http://:9080 {
	handle /healthz {
		rewrite * /api/health
		reverse_proxy backend:4174
	}
}
