{
  "name": "omnidocs-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:portable": "tsc -b && node --import tsx scripts/build-portable.mjs",
    "studio": "npm run build && npm start",
    "service": "OMNIDOCS_MODE=service node --import tsx server/index.ts --production",
    "service:local": "node --import tsx scripts/start-service.ts",
    "service:admin": "bash scripts/start-admin-service.sh",
    "service:dev": "OMNIDOCS_MODE=service OMNIDOCS_DEV_MAIL=1 OMNIDOCS_PUBLIC_URL=http://127.0.0.1:5173 node scripts/dev.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.9.0",
    "bpmn-js": "^18.9.0",
    "chokidar": "^4.0.3",
    "elkjs": "^0.9.3",
    "express": "^5.1.0",
    "openid-client": "^6.9.1",
    "postgres": "3.4.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxen": "10.0.0",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "overrides": {
    "rollup": "4.64.0",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "browserslist": "4.29.3"
  }
}
